 w.i_class_id, \n    w.i_category_id\n) AS web_sales\nUNION ALL\n(\n  SELECT \n    'catalog' AS channel, \n    c.i_brand_id, \n    c.i_class_id, \n    c.i_category_id, \n    SUM(c.cs_quantity * c.cs_list_price - c.cs_wholesale_cost) AS sales,\n    COUNT(*) AS number_sales\n  FROM \n    catalog_sales c\n  JOIN \n    item i ON c.cs_item_sk = i.i_item_sk\n  JOIN \n    date_dim d ON c.cs_sold_date_sk = d.d_date_sk\n  WHERE \n    c.cs_sold_date_sk >= (SELECT d_date_sk FROM date_dim WHERE d_year = 1998 AND d_moy = 12 AND d_dom = 13)\n  GROUP BY \n    c.i_brand_id, \n    c.i_class_id, \n    c.i_category_id\n) AS catalog_sales;\n```\n\nThis rewritten query applies the given rule to each of the sub-queries and combines them using `UNION ALL`. The resulting query should produce the same output as the original query.", 'time': 10.218552112579346}
