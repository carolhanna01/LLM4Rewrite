  SUM(CASE WHEN s.channel = 'web' THEN ws_ext_sales_price ELSE 0.0 END) AS web_sales_amt,
  SUM(CASE WHEN s.channel = 'catalog' THEN cs_ext_sales_price ELSE 0.0 END) AS catalog_sales_amt
