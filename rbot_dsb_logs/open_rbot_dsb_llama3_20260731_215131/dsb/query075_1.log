sales AS (\n    SELECT \n      ss_item_sk,\n      ss_sold_date_sk,\n      ss_quantity,\n      ss_ext_sales_price,\n      ...\n    FROM \n      store_sales\n  ),\n  \n  web_sales AS (\n    SELECT \n      ws_item_sk,\n      ws_sold_date_sk,\n      ws_quantity,\n      ws_ext_sales_price,\n      ...\n    FROM \n      web_sales\n  ),\n  \n  catalog_sales AS (\n    SELECT \n      cs_item_sk,\n      cs_sold_date_sk,\n      cs_quantity,\n      cs_ext_sales_price,\n      ...\n    FROM \n      catalog_sales\n  )\n  \n-- Main query\nSELECT \n  d_year,\n  i_brand_id,\n  i_class_id,\n  i_category_id,\n  i_manufact_id,\n  SUM(CASE WHEN ... THEN $5 ELSE 0 END) AS sales_cnt,\n  SUM(CASE WHEN ... THEN $6 ELSE 0.0 END) AS sales_amt\nFROM \n  (SELECT * FROM store_sales UNION ALL SELECT * FROM web_sales UNION ALL SELECT * FROM catalog_sales) AS all_sales\nJOIN \n  date_dim ON d_date_sk = all_sales.ss_sold_date_sk OR d_date_sk = all_sales.ws_sold_date_sk OR d_date_sk = all_sales.cs_sold_date_sk\nJOIN \n  item ON i_item_sk = all_sales.ss_item_sk OR i_item_sk = all_sales.ws_item_sk OR i_item_sk = all_sales.cs_item_sk\nWHERE \n  ...\nGROUP BY \n  d_year, i_brand_id, i_class_id, i_category_id, i_manufact_id;\n```\n\nThis rewritten query uses a common table expression (CTE) to define the base tables and then joins them together with the `date_dim` and `item` tables. The filter conditions are applied in the main query, and the aggregations are performed using the `SUM` function.", 'time': 9.85254716873169}
