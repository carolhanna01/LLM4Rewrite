tem_sk IS NOT NULL THEN ss_quantity ELSE cs_quantity END) AS avg_weekly_sales\n    FROM \n      item i\n      LEFT JOIN store_sales ss ON i_item_sk = ss_i_item_sk AND d_date_sk = ss_sold_date_sk\n      LEFT JOIN catalog_sales cs ON i_item_sk = cs_i_item_sk AND d_date_sk = cs_sold_date_sk\n      LEFT JOIN web_sales ws ON i_item_sk = ws_i_item_sk AND d_date_sk = ws_sold_date_sk\n    WHERE \n      s_item_sk IS NOT NULL OR cs_item_sk IS NOT NULL OR ws_item_sk IS NOT NULL\n    GROUP BY \n      i_category_id\n  ),\n  \n  -- Filter by date range and manager ID\n  filtered_sales AS (\n    SELECT * FROM weekly_sales\n    WHERE \n      d_week_seq BETWEEN 1999 AND (1999 + 2)\n      AND i_manager_id BETWEEN 7 AND 16\n  )\n\nSELECT \n  *\nFROM \n  filtered_sales;\n```\n\nThis rewritten query uses Common Table Expressions (CTEs) to break down the complex query into smaller, more manageable parts. The first CTE calculates the average sales per week for each category, and the second CTE filters the results by date range and manager ID.\n\nNote that this is just one possible way to rewrite the query, and there may be other approaches depending on the specific requirements and constraints of your use case.", 'time': 42.986114263534546}
