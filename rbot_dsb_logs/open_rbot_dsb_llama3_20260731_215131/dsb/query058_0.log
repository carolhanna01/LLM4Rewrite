```sql
WITH 
  -- Define the common subquery for all three sales tables
  sales_data AS (
    SELECT 
      s.item_id,
      c.birth_year,
      s.ext_sales_price,
      d.d_date
    FROM 
      (SELECT * FROM store_sales WHERE ... AND ...) s
    JOIN 
      item i ON s.item_sk = i.item_sk
    JOIN 
      customer c ON s.customer_sk = c.customer_sk
    JOIN 
      date_dim d ON s_sold_date_sk = d.date_sk
  UNION ALL
    SELECT 
      c.item_id,
      c.birth_year,
      c.ext_sales_price,
      d.d_date
    FROM 
      (SELECT * FROM catalog_sales WHERE ... AND ...) c
    JOIN 
      item i ON c.item_sk = i.item_sk
    JOIN 
      customer c ON c.customer_sk = c.customer_sk
    JOIN 
      date_dim d ON c_sold_date_sk = d.date_sk
  UNION ALL
    SELECT 
      w.item_id,
      w.birth_year,
      w.ext_sales_price,
      d.d_date
    FROM 
      (SELECT * FROM web_sales WHERE ... AND ...) w
    JOIN 
      item i ON w.item_sk = i.item_sk
    JOIN 
      customer c ON w.customer_sk = c.customer_sk
    JOIN 
      date_dim d ON w_sold_date_sk = d.date_sk
  ),
  
  -- Define the aggregated data for each sales table
  sales_agg AS (
    SELECT 
      item_id,
      birth_year,
      SUM(ext_sales_price) AS total_sales
    FROM 
      sales_data
    GROUP BY 
      item_id, birth_year
  )

-- Final query to analyze the aggregated data
SELECT 
  s.item_id,
  s.birth_year,
  s.total_sales,
  (s.total_sales / (SELECT AVG(total_sales) FROM sales_agg)) AS sales_ratio
FROM 
  sales_agg s
WHERE 
  s.birth_year BETWEEN 1987 AND 1993;
```

