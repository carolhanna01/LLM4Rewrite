_brand_id, \n  i_class_id, \n  i_category_id, \n  i_manufact_id, \n  SUM(CASE WHEN cs_quantity IS NOT NULL THEN cs_quantity ELSE 0 END) AS sales_cnt,\n  SUM(CASE WHEN cs_ext_sales_price IS NOT NULL THEN cs_ext_sales_price ELSE 0.0 END) AS sales_amt\nFROM \n  catalog_sales\nWHERE \n  (i_category = 'Electronics' AND \n   (cs_sales_price / cs_list_price) >= 0.80 AND \n   (cs_sales_price / cs_list_price) <= 1.00 AND \n   (cr_reason_sk IN (3, 6, 18, 30, 40)))\nGROUP BY \n  d_year, \n  i_brand_id, \n  i_class_id, \n  i_category_id, \n  i_manufact_id;\n```\n\nSQL Query Rewrite Rule:\n```\nSELECT \n  d_year, \n  i_brand_id, \n  i_class_id, \n  i_category_id, \n  i_manufact_id, \n  SUM(CASE WHEN cs_quantity IS NOT NULL THEN cs_quantity ELSE 0 END) AS sales_cnt,\n  SUM(CASE WHEN cs_ext_sales_price IS NOT NULL THEN cs_ext_sales_price ELSE 0.0 END) AS sales_amt\nFROM \n  catalog_sales\nWHERE \n  (i_category = 'Electronics' AND \n   (cs_sales_price / cs_list_price) >= 0.80 AND \n   (cs_sales_price / cs_list_price) <= 1.00 AND \n   SEARCH(cr_reason_sk, Sarg[3, 6, 18, 30, 40]))\nGROUP BY \n  d_year, \n  i_brand_id, \n  i_class_id, \n  i_category_id, \n  i_manufact_id;\n```\n\nThe SQL query and the SQL query rewrite rule are identical.", 'time': 18.624752044677734}
