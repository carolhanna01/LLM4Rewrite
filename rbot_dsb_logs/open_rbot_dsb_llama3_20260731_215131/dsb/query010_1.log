      wss.customer_sk,
      wss.item_sk,
      wss.sales_date_sk,
      wss.list_price,
      wss.sales_price,
      wss.manager_id
    FROM 
      web_sales wss
    WHERE 
      wss.year = 2001 AND
      wss.moy >= 9 AND
      wss.moy <= 12
  ),
  
  -- Define a CTE for the catalog sales data
  catalog_sales AS (
    SELECT 
      css.customer_sk,
      css.item_sk,
      css.sales_date_sk,
      css.list_price,
      css.sales_price,
      css.manager_id
    FROM 
      catalog_sales css
