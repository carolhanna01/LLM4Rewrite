  *
FROM 
  item_sales
JOIN 
  customer_demographics ON i_item_sk = c_customer_sk
WHERE 
  -- Filter out items with a wholesale cost outside the range [73, 93]
  i_current_price BETWEEN 73 AND 93
  AND 
  -- Filter out customers who are not married or have an unknown education status
  cd_marital_status NOT IN ('M', 'S') OR cd_education_status IN ('Unknown', '2 yr Degree')
  AND 
  -- Filter out customers who do not live in the states IL, ME, or MI
  ca_state IN ('IL', 'ME', 'MI');
