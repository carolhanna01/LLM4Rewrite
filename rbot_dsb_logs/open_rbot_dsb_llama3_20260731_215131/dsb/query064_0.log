```sql
WITH 
  -- Define a common table expression (CTE) for the item sales and returns
  item_sales AS (
    SELECT 
      i_item_sk, 
      SUM(ss_ext_list_price) AS total_revenue,
      COUNT(*) AS num_items_sold
    FROM 
      store_sales
    GROUP BY 
      i_item_sk
  ),
  
  -- Define a CTE for the customer demographics
  customer_demographics AS (
    SELECT 
      c_customer_sk, 
      cd_demo_sk, 
      hd_demo_sk, 
      ca_state
