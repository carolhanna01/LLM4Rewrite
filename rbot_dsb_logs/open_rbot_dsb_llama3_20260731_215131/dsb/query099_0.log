       ,cs_sold_date_sk
       FROM 
           catalog_sales
         JOIN warehouse ON cs_warehouse_sk = w_warehouse_sk
         JOIN ship_mode ON cs_ship_mode_sk = sm_ship_mode_sk
         JOIN call_center ON cs_call_center_sk = cc_call_center_sk
         JOIN date_dim ON cs_ship_date_sk = d_date_sk
       WHERE 
           d_month_seq between 1201 and 1201 + 23
           AND cs_ship_date_sk   = d_date_sk
           AND cs_warehouse_sk   = w_warehouse_sk
           AND cs_ship_mode_sk   = sm_ship_mode_sk
           AND cs_call_center_sk = cc_call_center_sk
           AND cs_list_price between 248 and 277
           AND sm_type = 'LIBRARY'
           AND cc_class = 'small'
           AND w_gmt_offset = -5
    ) AS subquery
GROUP BY 
    substring(w_warehouse_name,1,20)
   ,sm_type
   ,cc_name
ORDER BY 
    substring(w_warehouse_name,1,20)
   ,sm_type
   ,cc_name
LIMIT 100;
```

